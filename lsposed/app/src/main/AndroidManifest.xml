<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WifiManager 的查询/扫描接口 (isWifiEnabled/getScanResults/startScan) 都要这两个普通权限 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+ 扫描周边 WiFi 的正式权限 (老机型走 FINE_LOCATION) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- 实录 WiFi 扫描需要定位服务已开启, 权限同 FINE -->

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_mylocation"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <!-- Legacy Xposed 模块声明 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <!-- meta-data 的资源解析在部分 LSPosed 版本不可靠, 用双语句面值 -->
        <meta-data android:name="xposeddescription"
            android:value="Record real-location datasets and replay them to scoped apps / 实录地点定位数据并对作用域 App 回放" />
        <meta-data android:name="xposedscope" android:resource="@array/scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 跨进程配置通道: 被注入的目标进程用它读"当前选中地点"(XSharedPreferences 在本机读不到) -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="com.locrec.app.config"
            android:exported="true" />

        <!-- 配置通道之二: 显式 ComponentName 的 bindService 不受 Android 11+ 包可见性限制,
             供 provider 被 "Unknown authority" 拦住的 ROM (Android 16 实测) 使用 -->
        <service
            android:name=".ConfigService"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.locrec.app.CONFIG" />
            </intent-filter>
        </service>
    </application>
</manifest>
